rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == 'mcpenchev@gmail.com'; }
    function isEditor() { return isOwner() || (signedIn() && exists(/databases/$(database)/documents/roles/$(email()))); }

    // Helpers (editors). Only the owner manages them; a person may read their own role doc.
    match /roles/{e} {
      allow read: if isOwner() || (signedIn() && email() == e);
      allow write: if isOwner();
    }

    // All litter data: editors only.
    match /litters/{litter} {
      allow read, write: if isEditor();
      match /{document=**} {
        allow read, write: if isEditor();
      }
    }

    // Per-owner dossiers: an owner (viewer) reads only the ones under their own email.
    match /dossiers/{e}/byLitter/{litter} {
      allow read: if isEditor() || (signedIn() && email() == e);
      allow write: if isEditor();
    }

    // Photos: editors; a viewer only for puppies in their own dossier.
    match /photos/{id} {
      allow read: if isEditor() || (signedIn() &&
        resource.data.pid in get(/databases/$(database)/documents/dossiers/$(email())/byLitter/$(resource.data.litter)).data.pids);
      allow write: if isEditor();
    }
  }
}
